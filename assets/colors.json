    {"id": "snake-light-level-3", "kind": "graphic", "foreground": "#75680c", "background": "#ffffff", "where": "snake (light): level 3 cell"},
    {"id": "snake-light-level-4", "kind": "graphic", "foreground": "#4a4106", "background": "#ffffff", "where": "snake (light): level 4 cell"},
    {"id": "snake-light-snake", "kind": "graphic", "foreground": "#0d1117", "background": "#ffffff", "where": "snake (light): the snake"},

    {"id": "snake-dark-level-0", "kind": "graphic", "foreground": "#161b22", "background": "#0d1117", "where": "snake (dark): empty day cell", "exempt": true, "reason": "level-0 cell marks a day with no contributions; it carries no information beyond the grid position"},
