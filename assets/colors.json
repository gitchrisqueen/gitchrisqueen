    {"id": "snake-dark-level-3", "kind": "graphic", "foreground": "#c4b228", "background": "#0d1117", "where": "snake (dark): level 3 cell"},
    {"id": "snake-dark-level-4", "kind": "graphic", "foreground": "#e9d437", "background": "#0d1117", "where": "snake (dark): level 4 cell"},
    {"id": "snake-dark-snake", "kind": "graphic", "foreground": "#efe9d2", "background": "#0d1117", "where": "snake (dark): the snake"}
