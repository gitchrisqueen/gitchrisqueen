    {"id": "header-wave", "kind": "graphic", "foreground": "#a89816", "background": "#0d1117", "where": "assets/header-*.svg: wave lines (drawn at 18-75% stroke opacity)", "exempt": true, "reason": "decorative texture; carries no information"},
    {"id": "footer-text", "kind": "text", "foreground": "#e9d437", "background": "#0d1117", "where": "assets/footer-*.svg: location line"},
    {"id": "footer-rule", "kind": "graphic", "foreground": "#e9d437", "background": "#0d1117", "where": "assets/footer-*.svg: centre of the tapered rule and the diamond"},
    {"id": "footer-wave", "kind": "graphic", "foreground": "#a89816", "background": "#0d1117", "where": "assets/footer-*.svg: wave lines (drawn at 18-60% stroke opacity)", "exempt": true, "reason": "decorative texture; carries no information"},

    {"id": "badge-label", "kind": "text", "foreground": "#ffffff", "background": "#24292f", "where": "README badges: left label (shields labelColor)"},
    {"id": "badge-passing", "kind": "text", "foreground": "#ffffff", "background": "#1a7f37", "where": "README badges: value when the check passes"},
